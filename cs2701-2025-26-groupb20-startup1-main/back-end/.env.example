# ArtXPlore backend local environment template
# Copy to .env and fill with your local/LAN values.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=artxplore
DB_USER=artxplore
DB_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# HTTP server
SERVER_PORT=8080

# Auth cookie/session
AUTH_COOKIE_NAME=AXP_SESSION
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE=86400
AUTH_SESSION_TTL=PT24H
AUTH_REDIS_KEY_PREFIX=axp:sessions:



